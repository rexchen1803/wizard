# Only the reviewed public tree belongs in Git. Private workspaces and SDKs stay local.
/*
!/.github/
!/.gitignore
!/AGENTS.md
!/App/
!/CHANGELOG.md
!/CONTRIBUTING.md
!/LICENSE
!/NOTICE
!/OPEN_SOURCE_EXPORT_REPORT.json
!/README.md
!/SECURITY.md
!/THIRD_PARTY.md
!/assets/
!/docs/
!/licenses/
!/scripts/
!/tests/

/.github/*
!/.github/ISSUE_TEMPLATE/
!/.github/pull_request_template.md
!/.github/workflows/

/App/*
!/App/IWFrameProbe.h
!/App/IWHTTPTransport.h
!/App/IWMediaCatalog.h
!/App/IWWeatherService.h
!/App/IWWeatherService.m
!/App/Info.plist
!/App/Resources/
!/App/WizardPowerTweak/
!/App/main.m
!/App/tests/

/assets/*
!/assets/demo/
!/assets/media/
!/assets/readme/

/docs/*
!/docs/AGENT-INSTALL.md
!/docs/COMPATIBILITY.md
!/docs/INSTALL.md
!/docs/open-source/

/licenses/*
!/licenses/Material-Icons-Apache-2.0.txt

/scripts/*
!/scripts/build-ipad.sh
!/scripts/build-power.sh
!/scripts/check-repository.py
!/scripts/install-wizard.sh
!/scripts/package-release.py
!/scripts/prepare-open-source.py

/tests/*
!/tests/native-regressions.py
!/tests/package-regressions.py
!/tests/repository-regressions.py

/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/bug_report.yml
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/ISSUE_TEMPLATE/feature_request.yml

/.github/workflows/*
!/.github/workflows/ci.yml

/App/Resources/*
!/App/Resources/Default-Landscape.png
!/App/Resources/Default-Landscape@2x.png
!/App/Resources/Icon-76.png
!/App/Resources/Icon-76@2x.png
!/App/Resources/Icon-83.5@2x.png
!/App/Resources/Icon.svg
!/App/Resources/Launch.svg

/App/WizardPowerTweak/*
!/App/WizardPowerTweak/README.md
!/App/WizardPowerTweak/Tweak.xm
!/App/WizardPowerTweak/WizardPower.plist

/App/tests/*
!/App/tests/cast-lifecycle-regressions.py
!/App/tests/gallery-media-regressions.py
!/App/tests/http-transport-regressions.m
!/App/tests/media-lifecycle-regressions.py
!/App/tests/menu-layout-regressions.py
!/App/tests/power-edge-regressions.py
!/App/tests/run-http-transport-regressions.sh
!/App/tests/run-weather-service-regressions.sh
!/App/tests/weather-service-regressions.m

/assets/demo/*
!/assets/demo/README.md
!/assets/demo/categories-ipad2.png
!/assets/demo/gallery-ipad2.png
!/assets/demo/home-ipad2.png

/assets/media/*
!/assets/media/ATTRIBUTION.md
!/assets/media/MANIFEST.json

/assets/readme/*
!/assets/readme/hero-dark.svg
!/assets/readme/hero-mobile-dark.svg
!/assets/readme/hero-mobile.svg
!/assets/readme/hero.svg

/docs/open-source/*
!/docs/open-source/GTA6-MATERIALS.md
!/docs/open-source/INSTALL.md
!/docs/open-source/MATERIAL-ICONS.md
!/docs/open-source/PRIVACY.md
!/docs/open-source/README.md

**/.DS_Store
**/__pycache__/
**/*.py[cod]
