# Only the reviewed public tree belongs in Git. Private workspaces and SDKs stay local.
/*
!/.github/
!/.gitignore
!/AGENTS.md
!/PRODUCT.md
!/DESIGN.md
!/App/
!/CHANGELOG.md
!/CONTRIBUTING.md
!/LICENSE
!/NOTICE
!/OPEN_SOURCE_EXPORT_REPORT.json
!/README.md
!/README.en.md
!/SECURITY.md
!/THIRD_PARTY.md
!/assets/
!/docs/
!/licenses/
!/scripts/
!/tests/

/.github/*
!/.github/ISSUE_TEMPLATE/
!/.github/pull_request_template.md
!/.github/workflows/

/App/*
!/App/IWFrameProbe.h
!/App/IWHTTPTransport.h
!/App/IWMediaCatalog.h
!/App/IWWeatherService.h
!/App/IWWeatherService.m
!/App/Info.plist
!/App/Resources/
!/App/WizardPowerTweak/
!/App/main.m
!/App/tests/

/assets/*
!/assets/demo/
!/assets/media/
!/assets/readme/

/docs/*
!/docs/AGENT-INSTALL.md
!/docs/COMPATIBILITY.md
!/docs/INSTALL.md
!/docs/open-source/
!/docs/en/
!/docs/zh-CN/

/licenses/*
